# {{ ansible_managed }}
# Minimal configuration for a single-node OpenHPC Slurm test cluster.

ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_node_name }}
SlurmUser=slurm
SlurmdUser=root

AuthType=auth/munge
CredType=cred/munge

StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SlurmctldPort=6817
SlurmdPort=6818
SlurmctldTimeout=120
SlurmdTimeout=300
KillWait=30
MinJobAge=300

SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdLogFile=/var/log/slurm/slurmd.log
SlurmctldDebug=info
SlurmdDebug=info

SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
DefMemPerCPU=1024
SwitchType=switch/none
MpiDefault=none
ProctrackType=proctrack/cgroup
TaskPlugin=task/affinity
PropagateResourceLimitsExcept=MEMLOCK
# Do not use OpenHPC's slurm.epilog.clean here: it calls squeue in the job
# completion path, but skips its process cleanup whenever slurmctld shares the
# compute node. On this single host it can block completion without doing any
# useful cleanup.
ReturnToService=2
SlurmctldParameters=enable_configless
LaunchParameters=use_interactive_step

# Record basic job completion information without configuring SlurmDBD.
JobAcctGatherFrequency=30
JobAcctGatherType=jobacct_gather/none
JobCompType=jobcomp/filetxt
JobCompLoc=/var/log/slurm/slurm_jobcomp.log

# This controller and compute node are the same host. Keep Slurm daemon
# communication on IPv4 loopback instead of the machine's public hostname,
# which may resolve to a firewalled external interface or an IPv6-only alias.
NodeName={{ slurm_node_name }} NodeHostname={{ slurm_node_name }} NodeAddr=127.0.0.1 CPUs={{ slurm_cpus }} RealMemory={{ slurm_real_memory_mb }} State=UNKNOWN
# Share the node between jobs so --cpus-per-task is honored. With EXCLUSIVE,
# every job claims the whole node and receives all CPUs regardless of the
# requested count.
PartitionName={{ slurm_partition_name }} Nodes={{ slurm_node_name }} Default=YES MaxTime=01:00:00 State=UP Oversubscribe=NO
