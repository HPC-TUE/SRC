<%-
  base_url = "/node/#{host}/#{port}"
  login_url = "#{base_url}/login"
  next_url = "#{base_url}/lab"
%>

<form action="<%= login_url %>?next=<%= CGI.escape(next_url) %>" method="post" target="_blank">
  <input type="hidden" name="password" value="<%= password %>">
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-eye"></i> Connect to JupyterLab
  </button>
</form>
