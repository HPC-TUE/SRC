---
cluster: "snellius"
cacheable: false
form:
  - bc_queue
  - bc_num_hours
  - bc_num_slots
attributes:
  # Keep the only valid partition fixed instead of presenting a free-text box.
  bc_queue: "{{ slurm_partition_name }}"
  bc_num_hours:
    widget: "number_field"
    label: "Maximum runtime (hours)"
    help: "The training partition has a one-hour maximum job time."
    value: "1"
    min: 1
    max: 1
    step: 1
    required: true
    display: true
  bc_num_slots:
    widget: "number_field"
    label: "CPUs"
    help: "Select the CPUs to reserve on the single compute node."
    value: "1"
    min: 1
    max: {{ ood_max_cpus }}
    step: 1
    required: true
    display: true
